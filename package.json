{
  "name": "scapegoat-vscode",
  "displayName": "ScapeGoat",
  "description": "Parses scapegoat output and shows as problems in scala files",
  "version": "0.3.0",
  "publisher": "michael72",
  "engines": {
    "vscode": "^1.90.0"
  },
  "license": "SEE LICENSE IN LICENSE.txt",
  "bugs": {
    "url": "https://github.com/michael72/scapegoat-vscode/issues"
  },
  "homepage": "https://github.com/michael72/scapegoat-vscode/blob/main/README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/michael72/scapegoat-vscode.git"
  },
  "categories": [
    "Linters"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ScapeGoat.Run",
        "title": "ScapeGoat: Run parser"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "pretest": "npm run compile && npm run lint",
    "test": "mocha --ui tdd \"out/test/**/*.test.js\""
  },
  "dependencies": {
    "fast-xml-parser": "^5.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/vscode": "~1.90.0",
    "eslint": "^10.14.0",
    "mocha": "^12.0.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "minimatch": "^11.0.4",
    "glob": "^14.0.3"
  }
}
